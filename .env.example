# Template for local environment variables.
#
# This file is NOT loaded by the application. Copy it to `.env` and set real values:
#   cp .env.example .env
#
# Required keys and validation rules live in: src/core/config/env.validation.ts
# Typed key names for ConfigService: src/core/config/config.keys.ts
#
# Every value below is a placeholder. Replace each <...> token. Do not commit real secrets.

# Database (Prisma)
# Runtime queries use DATABASE_URL (application role).
# Prisma CLI (db push / seed) uses DIRECT_URL (owner role).
DATABASE_URL=postgresql://<app-user>:<app-password>@<db-host>:5432/<db-name>?schema=public
DIRECT_URL=postgresql://<owner-user>:<owner-password>@<db-host>:5432/<db-name>?schema=public

# Passwords for the two database roles above (local reference only; not read at API startup).
OL_OWNER_PASSWORD=<owner-password>
OL_APPLICATION_PASSWORD=<app-password>

# Application
NODE_ENV=development
PORT=5000
PLATFORM_NAME=<platform-name>

# Security
JWT_SECRET=<jwt-secret>
JWT_EXPIRATION_TIME=3600s

# Google OAuth
GOOGLE_CLIENT_ID=<google-client-id>
GOOGLE_CLIENT_SECRET=<google-client-secret>
GOOGLE_CALLBACK_URL=http://localhost:5000/api/v1/auth/google/callback

# Redis
# Host only — no redis:// or rediss:// prefix.
# Username defaults to "default".
# Set REDIS_TLS=true only when the endpoint requires TLS.
REDIS_HOST=<redis-host>
REDIS_PORT=<redis-port>
REDIS_PASSWORD=<redis-password>
REDIS_USERNAME=<redis-username>
REDIS_TLS=false

# Swagger — SWAGGER_PATH must be a long non-guessable segment (not docs or swagger).
# Set SWAGGER_ENABLED=false to turn docs off.
SWAGGER_ENABLED=true
SWAGGER_PATH=<swagger-path>

# Transactional email (Brevo)
BREVO_API_KEY=<brevo-api-key>
BREVO_SENDER_EMAIL=<sender-email>
BREVO_SENDER_NAME=<sender-name>

# Frontend (outbound email links + default OAuth redirect)
FRONTEND_BASE_URL=<frontend-base-url>

# Comma-separated browser origins allowed for CORS and Google OAuth redirects.
ALLOWED_ORIGINS=<allowed-origin>,<allowed-origin>

# Public API origin for the email brand logo (served at /email/brand-logo.png).
API_PUBLIC_BASE_URL=<api-public-base-url>

# Database seed only (npm run db:seed — not validated at API startup)
INITIAL_ADMIN_PASSWORD=<initial-admin-password>

# PayChangu. PAYCHANGU_MODE selects which key set checkout, verify, and webhooks use.
# Register the webhook as POST {API_PUBLIC_BASE_URL}/api/v1/payments/webhooks/paychangu
PAYCHANGU_MODE=test
PAYCHANGU_TEST_PUBLIC_KEY=<paychangu-test-public-key>
PAYCHANGU_TEST_SECRET_KEY=<paychangu-test-secret-key>
PAYCHANGU_TEST_WEBHOOK_SECRET=<paychangu-test-webhook-secret>
PAYCHANGU_LIVE_PUBLIC_KEY=<paychangu-live-public-key>
PAYCHANGU_LIVE_SECRET_KEY=<paychangu-live-secret-key>
PAYCHANGU_LIVE_WEBHOOK_SECRET=<paychangu-live-webhook-secret>
PAYCHANGU_BASE_URL=<paychangu-base-url>

# Optional local tunnel (not validated at API startup)
NGROK_URL=<ngrok-url>
